# win11-base settings template.
# Copy to .env and fill in real values:  cp .env.example .env && chmod 600 .env
# .env is git-ignored; docker compose reads it from this directory automatically.

# ---- required: injected into the guest on startup ----
WIN11_USER=operator
WIN11_PASSWORD=change-me

# Credential currently on the sealed disk. The image ships aigc/aigc as a first-login
# key only (same idea as dockur's admin/admin); override here if you already rotated it.
WIN11_INIT_USER=aigc
WIN11_INIT_PASSWORD=aigc

# ---- optional ----
# KMS host[:port] to activate against. Leave empty to skip activation.
WIN11_KMS=
WIN11_KMS_KEY=

# Skip guest discovery / change how long the injector waits for the guest.
# WIN11_GUEST_IP=172.30.0.2
# WIN11_INJECT_TIMEOUT=900

# ---- VM sizing and published ports ----
WIN11_RAM_SIZE=4G
WIN11_CPU_CORES=4
WIN11_DISK_SIZE=64G
WIN11_PORT_VNC=8006
WIN11_PORT_RDP=3389
WIN11_PORT_SSH=2222
WIN11_CONTAINER_NAME=win11
