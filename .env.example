# win11 密钥模板：cp .env.example .env 后填真实值。
# .env 被 .gitignore 排除，永不进 git；docker compose 自动读取同目录 .env。
#
# ---- 安装期凭据（dockurr/windows 装机 answer file 用，仅自建安装实例需要）----
WIN11_INSTALL_USER=aigc
WIN11_INSTALL_PASSWORD=CHANGE_ME
#
# ---- 运行期注入（win11/base:latest 基础镜像，容器启动后由 win11-inject 推入 guest）----
# 目标账户名与密码
WIN11_USER=aigc
WIN11_PASSWORD=CHANGE_ME
# guest 盘当前生效的初始凭据（种子盘默认 aigc/aigc；已被改过就填改过的）
WIN11_INIT_USER=aigc
WIN11_INIT_PASSWORD=aigc
#
# ---- KMS 激活（可留空；激活后每 7 天联网续期）----
WIN11_KMS=kms.0t.net.cn
WIN11_KMS_KEY=W269N-WFGWX-YVC9B-4J6C9-T83GX
#
# ---- 资源与端口 ----
WIN11_RAM_SIZE=6G
WIN11_CPU_CORES=4
WIN11_PORT_VNC=8006
WIN11_PORT_RDP=3389
WIN11_PORT_SSH=2222
#
# ---- 桌面形态（默认 on：纯黑+无图标+任务栏自动隐藏；off 保持原生桌面）----
WIN11_DESKTOP=on
#
# ---- midscene-pc 窗口级 AI API（guest :3333，off 关闭）----
# TOKEN 为空时 API 只绑 guest 本机回环；设置后才对外（宿主端口见 WIN11_PORT_MSPC）
# 网关四项仅 AI 端点需要；纯窗口 API 可不填
#WIN11_MSPC=off
#WIN11_MSPC_TOKEN=
#WIN11_MSPC_GATEWAY=
#WIN11_MSPC_MODEL_KEY=
#WIN11_MSPC_MODEL=gpt-5.6-luna
#WIN11_MSPC_FAMILY=gpt-5
#WIN11_PORT_MSPC=3333
